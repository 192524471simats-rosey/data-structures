#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void insert(int key) {
    int index = key % SIZE;

    while (hashTable[index] != -1)
        index = (index + 1) % SIZE;

    hashTable[index] = key;
}

int main() {
    int i, n, key;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    printf("Enter number of keys: ");
    scanf("%d", &n);

    printf("Enter keys: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &key);
        insert(key);
    }

    printf("Hash Table:\n");
    for (i = 0; i < SIZE; i++)
        printf("%d : %d\n", i, hashTable[i]);

    return 0;
}
